# =============================================================================
# GLM-5.1 2P2D Serving - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================
# ACCOUNT_ID is auto-detected from AWS CLI credentials, no need to set manually.

# --- Required ---
AWS_REGION=ap-northeast-1

# --- Optional (defaults shown) ---
# CLUSTER_NAME=gpu-eks-cluster
# NAMESPACE=glm51-test

# --- S3 (model weights + DeepGEMM cache) ---
# S3_BUCKET=glm51-nixl-test-${ACCOUNT_ID}
# MODEL_S3_PREFIX=models/GLM-5.1-FP8

# --- Container Image ---
# IMAGE_REPO=sglang-nixl
# IMAGE_TAG=latest

# --- Cluster Topology ---
# GPU_INSTANCE_TYPE=p5en.48xlarge
# PREFILL_REPLICAS=2
# DECODE_REPLICAS=2
# PREFILL_PP=2
# PREFILL_TP=8
# DECODE_TP=16
# DECODE_DP=16

# --- DeepGEMM Cache ---
# DEEPGEMM_CACHE_DIR=/data/sglang/deep_gemm
# DEEPGEMM_SYNC_INTERVAL=300

# --- Image Build (only needed for 01-build-image.sh) ---
# NIXL_REPO=https://github.com/xqun3/nixl.git
# NIXL_VERSION=ac46102d8d1c971e5f36a5568cbd3b8a2ca23cb1
# SGLANG_VERSION=0.5.10
# UCCL_REPO=https://github.com/uccl-project/uccl.git
# UCCL_REF=8ac850bd
