# =============================================================================
# EKS GPU Cluster - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================
# ACCOUNT_ID is auto-detected from AWS CLI credentials, no need to set manually.

# --- Required ---
AWS_REGION=ap-northeast-1

# --- Optional (defaults shown) ---
# CLUSTER_NAME=gpu-eks-cluster
# K8S_VERSION=1.35
# TARGET_AZ=${AWS_REGION}a

# --- GPU Node Group ---
# GPU_INSTANCE_TYPE=p5en.48xlarge
# GPU_NODE_COUNT=4
# GPU_NODE_MIN=0
# GPU_NODE_MAX=8
# GPU_PRICING=Spot
# GPU_NODEGROUP_NAME=gpu-p5en-spot

# --- System Node Group ---
# SYSTEM_INSTANCE_TYPE=m8g.xlarge
# SYSTEM_NODE_COUNT=1

# --- S3 (model weights + DeepGEMM cache) ---
# S3_BUCKET=glm51-nixl-test-${ACCOUNT_ID}
